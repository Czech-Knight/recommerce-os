# No configuration is needed for the local, seeded demo (npm run dev).
# For the real PostgreSQL/Redis backend, copy to .env and use Docker Compose.
DEMO_MODE=false
DATABASE_URL=postgresql://recommerce:recommerce@localhost:5432/recommerce
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
SHOPIFY_API_VERSION=2026-10
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,read_locations
# Optional AWS uploads (otherwise persisted in .data/uploads).
AWS_REGION=ap-southeast-2
S3_BUCKET=
S3_PUBLIC_BASE_URL=
# One-time bootstrap; used only by npm run db:admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
